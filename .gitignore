# The evidence trail is regenerated by running the checks; it is not carried in the repository.
.math/
node_modules/

# bun's lockfile: the repository carries npm's, and a second lockfile is a second truth.
bun.lock

# the build output of the browser example
examples/browser/dist/

# the local secrets of the development runs: the provider's key lives here and
# nowhere else. It is never committed, never bundled and never written to a file
# by the harness itself.
.env
