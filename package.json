{
  "name": "miha",
  "version": "0.0.0",
  "description": "A browser-first agent harness with a symmetric peer, written for embedding into any application",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check:budget": "bun scripts/check-budget.mjs",
    "check:docs": "bun scripts/check-docs.mjs links && bun scripts/check-docs.mjs decisions && bun scripts/check-docs.mjs attribution",
    "check:checks": "sh scripts/checks.sh",
    "check:types": "sh scripts/types.sh",
    "check:evidence": "mathc run",
    "check": "sh scripts/gate.sh",
    "gate": "sh scripts/gate.sh",
    "measure": "mathc-stand"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "typescript": "^5.9.2"
  }
}
